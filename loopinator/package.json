{
  "name": "loopinator",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6",
      "@types/bun": "^1.3.14",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.6.23",
      "@types/express": "^5.0.6",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.2",
      "@trpc/client": "^11.18.0",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter web --filter server dev",
    "build": "bun run --filter web --filter server build",
    "check-types": "bun run --filter '*' check-types",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "db:push": "bun run --filter @loopinator/db db:push",
    "db:studio": "bun run --filter @loopinator/db db:studio",
    "db:generate": "bun run --filter @loopinator/db db:generate",
    "db:migrate": "bun run --filter @loopinator/db db:migrate",
    "db:local": "bun run --filter @loopinator/db db:local",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "check:hover-button": "bun scripts/check-hover-button.ts",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry"
  },
  "dependencies": {
    "@loopinator/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loopinator/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "^22.13.14",
    "tsx": "^4.22.5",
    "typescript": "catalog:",
    "vercel": "^54.18.6"
  },
  "packageManager": "bun@1.3.14"
}
