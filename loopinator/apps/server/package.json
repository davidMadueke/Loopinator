{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@loopinator/api": "workspace:*",
    "@loopinator/auth": "workspace:*",
    "@loopinator/db": "workspace:*",
    "@loopinator/env": "workspace:*",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "cors": "^2.8.6",
    "dotenv": "catalog:",
    "express": "^5.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loopinator/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/cors": "^2.8.19",
    "@types/express": "catalog:",
    "tsdown": "^0.22.3",
    "typescript": "catalog:"
  }
}
